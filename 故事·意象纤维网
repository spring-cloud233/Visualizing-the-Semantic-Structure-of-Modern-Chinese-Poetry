<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<title>故事 · 潮水自指</title>
<script src="https://cdn.jsdelivr.net/npm/p5@1.9.0/lib/p5.min.js"></script>
<style>
  html, body { margin:0; height:100%; background:#030810; overflow:hidden;
               font-family:"PingFang SC","Microsoft YaHei",sans-serif; color:#dde4f0; }
  #scene { position:fixed; inset:0; }
  #scene canvas { display:block; }
  #labels { position:fixed; inset:0; pointer-events:none; overflow:hidden; z-index:10; }
  .label { position:absolute; transform:translate(-50%,-50%); white-space:nowrap;
           pointer-events:none; font-weight:500; letter-spacing:.02em;
           transition: color 0.15s; }
  .node-label { font-size:13px; color:#fff;
                text-shadow:0 0 6px #000, 0 0 12px #000, 0 0 4px #000; }
  .node-label.hovered { color:#fff;
                        text-shadow:0 0 8px #fff, 0 0 20px #A0C8FF, 0 0 3px #000; }
  .node-label.core { font-size:17px; color:#FFFFFF; font-weight:700;
                     text-shadow:0 0 10px #A0C8FF, 0 0 24px #6098E0, 0 0 4px #000; }
  .node-label.sub { font-size:14px; color:#C8E0FF; font-weight:600;
                    text-shadow:0 0 8px #6098E0, 0 0 16px #6098E0, 0 0 4px #000; }
  #legend { position:fixed; right:20px; top:20px; z-index:20;
            background:rgba(0,10,25,0.7); padding:14px 18px; border-radius:8px;
            font:12px/1.9 "PingFang SC","Microsoft YaHei",sans-serif;
            pointer-events:none; backdrop-filter:blur(6px); min-width:180px;
            border:1px solid rgba(100,150,220,0.15); }
  #legend h4 { margin:0 0 8px; font-size:11px; color:#7A8FA8;
               letter-spacing:.2em; font-weight:500; text-transform:uppercase; }
  #legend .item { display:flex; align-items:center; gap:10px;
                  padding:3px 8px; margin:0 -8px; border-radius:4px;
                  cursor:pointer; pointer-events:auto;
                  transition: background 0.15s; }
  #legend .item:hover { background:rgba(255,255,255,0.08); }
  #legend .item.active { background:rgba(120,180,255,0.2); }
  #legend .item.active .name { color:#fff; font-weight:600; }
  #legend .item .name { color:#c8d4e0; }
  #legend .swatch { width:22px; height:2px; border-radius:1px; flex:0 0 auto; }
  #legend .swatch.dash { background-image: repeating-linear-gradient(
                        to right, currentColor 0, currentColor 4px,
                        transparent 4px, transparent 7px); }
  #status { position:fixed; right:20px; top:280px; z-index:20;
            background:rgba(0,10,25,0.7); padding:10px 16px; border-radius:8px;
            font:12px/1.6 "PingFang SC","Microsoft YaHei",sans-serif;
            pointer-events:none; backdrop-filter:blur(6px);
            border:1px solid rgba(100,150,220,0.15);
            opacity:0; transition: opacity 0.2s; }
  #status.on { opacity:1; }
  #status .k { color:#7A8FA8; font-size:11px; letter-spacing:.15em; }
  #status .v { color:#fff; font-size:14px; font-weight:600; margin-top:2px; }
  #status .reset { color:#80C0FF; font-size:11px; margin-top:6px; cursor:pointer;
                   pointer-events:auto; letter-spacing:.05em; }
  #status .reset:hover { text-decoration:underline; }
  #hud { position:fixed; left:20px; bottom:20px; color:#8090A8;
         font:11px/1.7 monospace; background:rgba(0,10,25,.5);
         padding:10px 14px; border-radius:6px; pointer-events:none; z-index:20;
         border:1px solid rgba(100,150,220,0.1); }
  #hud b { color:#C8DDFF; }
  #title { position:fixed; left:20px; top:20px; z-index:20;
           font-size:13px; color:#7A8FA8; letter-spacing:.3em; }
  #title b { color:#fff; font-weight:500; }
  #direction { position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
               z-index:20; font:12px/1 monospace; color:#5A7090;
               letter-spacing:.4em; pointer-events:none; }
  #direction b { color:#80C0FF; font-weight:400; }
</style>
