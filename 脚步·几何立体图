<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<title>脚步 · 意象维度空间</title>
<script src="https://cdn.jsdelivr.net/npm/p5@1.9.0/lib/p5.min.js"></script>
<style>
  html,body{margin:0;height:100%;overflow:hidden;background:#050510;}
  canvas{display:block;position:fixed;top:0;left:0;}
  #labels{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:10;}
  .label{
    position:absolute;
    transform:translate(-50%,-50%);
    font:13px/1.2 "PingFang SC","Microsoft YaHei","Noto Sans SC",sans-serif;
    white-space:nowrap;
    pointer-events:none;
  }
  .img-label{font-size:12px;font-weight:500;}
  .dim-label{font-size:15px;font-weight:700;letter-spacing:.1em;
             text-shadow:0 0 6px currentColor,0 0 14px currentColor,0 0 3px #000;}
  .step-label{font-size:13px;font-weight:700;color:#ffe9a8;
              text-shadow:0 0 6px #ffd66a,0 0 12px #ffd66a,0 0 3px #000;}
  #hud{position:fixed;left:16px;bottom:16px;color:#fff;font:14px/1.6 sans-serif;
       background:rgba(0,0,0,.4);padding:10px 14px;border-radius:8px;pointer-events:none;z-index:20;}
  #hint{position:fixed;right:16px;bottom:16px;color:#888;font:12px/1.7 sans-serif;z-index:20;
        text-align:right;}
  #hint b{color:#ccc;font-weight:600;}
</style>
</head>
<body>
<div id="labels"></div>
<div id="hud">脚步：—</div>
<div id="hint">
  <b>拖动</b> 旋转 · <b>滚轮</b> 缩放<br>
  <b>空格</b> 暂停 · <b>← →</b> 调速<br>
  <b>1–6</b> 单看某维度 · <b>0</b> 全部<br>
  <b>H</b> 隐藏/显示维度线
</div>
<script>
const dims = [
  { id:'time',     name:'时间',      color:[255,180, 80], dir:[ 1, 0.2,  0  ] },
  { id:'space',    name:'空间',      color:[ 80,180,255], dir:[ 0, 1,    0.2] },
  { id:'spirit',   name:'精神',      color:[255, 80,160], dir:[ 0, 0,    1  ] },
  { id:'religion', name:'宗教/哲学', color:[180,120,255], dir:[-1, 0.2,  0.2] },
  { id:'culture',  name:'文化',      color:[120,255,180], dir:[ 0.2,-1,  0.2] },
  { id:'sense',    name:'感官',      color:[255,255,120], dir:[ 0.2, 0.2,-1  ] },
];

const images = [
  { name:'蝉声',     order:0,  values:{ sense:0.9, spirit:0.3, time:0.10 } },
  { name:'烦躁',     order:1,  values:{ spirit:0.8, sense:0.5, time:0.15 } },
  { name:'匾额',     order:2,  values:{ culture:0.8, space:0.2, time:0.20 } },
  { name:'马匹',     order:3,  values:{ culture:0.7, space:0.3, spirit:0.4, time:0.25 } },
  { name:'尘埃',     order:4,  values:{ sense:0.6, space:0.4, time:0.30 } },
  { name:'水湄',     order:5,  values:{ space:0.5, sense:0.5, time:0.35 } },
  { name:'年龄',     order:6,  values:{ time:0.4, spirit:0.6, religion:0.3 } },
  { name:'沉睡者',   order:7,  values:{ spirit:0.9, religion:0.5, time:0.45 } },
  { name:'巨蟒',     order:8,  values:{ religion:0.8, spirit:0.7, culture:0.3, time:0.50 } },
  { name:'宫殿',     order:9,  values:{ space:0.7, culture:0.9, time:0.55 } },
  { name:'日影',     order:10, values:{ time:0.6, space:0.6, spirit:0.4, sense:0.5 } },
  { name:'盘膝',     order:11, values:{ spirit:0.8, religion:0.9, time:0.65 } },
  { name:'空白',     order:12, values:{ spirit:0.5, religion:0.4, time:0.70 } },
  { name:'水瓢',     order:13, values:{ culture:0.8, religion:0.6, space:0.5, time:0.75 } },
  { name:'旅人',     order:14, values:{ spirit:0.7, space:0.6, time:0.80 } },
  { name:'灰烬',     order:15, values:{ spirit:0.6, religion:0.9, time:0.85 } },
  { name:'念珠',     order:16, values:{ religion:0.9, culture:0.5, sense:0.3, time:0.90 } },
  { name:'星月',     order:17, values:{ space:0.8, spirit:0.7, religion:0.8, time:0.95 } },
  { name:'北北西',   order:18, values:{ space:0.9, culture:0.9, spirit:0.8, time:1.00 } },
  { name:'瞭望者',   order:19, values:{ space:1.0, spirit:1.0, culture:1.0, time:1.05 } },
  { name:'森林',     order:20, values:{ space:1.1, culture:1.0, spirit:0.8, time:1.10 } },
  { name:'东方诸星', order:21, values:{ space:1.2, religion:0.9, sense:0.8, time:1.15 } },
  { name:'月亮偏右', order:22, values:{ space:1.3, sense:0.9, time:1.20 } },
  { name:'渡河',     order:23, values:{ space:1.4, spirit:1.0, sense:1.0, time:1.25 } },
];

const SCALE = 150;
const DIM_THRESHOLD = 0.15;

// 球体 / 标签的两种状态色
const COLOR_DIM   = [ 70,  85, 115];   // 未聚焦：冷灰暗
const COLOR_LIT   = [255, 255, 255];   // 聚焦：纯白

let t = 0;
let playing = true;
let speed = 0.0006;
let soloDim = null;
let showDims = true;
let R;
const labelEls = {};

function setup() {
  const c = createCanvas(windowWidth, windowHeight, WEBGL);
  R = c._renderer || _renderer;
  textAlign(CENTER, CENTER);
  textFont('sans-serif');

  for (const d of dims) {
    d.vec = createVector(d.dir[0], d.dir[1], d.dir[2]).normalize();
  }
  for (const img of images) {
    img.pos = calcPos(img);
  }
  images.sort((a, b) => a.order - b.order);
  for (const d of dims) {
    d.points = images.slice().sort((a, b) =>
      (a.values[d.id] || 0) - (b.values[d.id] || 0));
  }

  camera(0, -260, 620, 0, 0, 0, 0, 1, 0);
  createLabels();
}

function createLabels() {
  const container = document.getElementById('labels');
  container.innerHTML = '';
  for (const k in labelEls) delete labelEls[k];

  for (const img of images) {
    const el = document.createElement('div');
    el.className = 'label img-label';
    el.textContent = img.name;
    container.appendChild(el);
    labelEls['img_' + img.name] = el;
  }
  for (const d of dims) {
    const el = document.createElement('div');
    el.className = 'label dim-label';
    el.textContent = d.name;
    el.style.color = `rgb(${d.color[0]},${d.color[1]},${d.color[2]})`;
    container.appendChild(el);
    labelEls['dim_' + d.id] = el;
  }
  const stepEl = document.createElement('div');
  stepEl.className = 'label step-label';
  stepEl.textContent = '脚步';
  container.appendChild(stepEl);
  labelEls['step'] = stepEl;
}

function calcPos(img) {
  const p = createVector(0, 0, 0);
  for (const d of dims) {
    const v = img.values[d.id] || 0;
    p.add(d.vec.copy().mult(v));
  }
  return p.mult(SCALE);
}

function worldToScreen(x, y, z) {
  if (!R || !R.uMVMatrix || !R.uPMatrix) return null;
  const mv = R.uMVMatrix.mat4;
  const pm = R.uPMatrix.mat4;

  const vx = mv[0]*x + mv[4]*y + mv[8]*z  + mv[12];
  const vy = mv[1]*x + mv[5]*y + mv[9]*z  + mv[13];
  const vz = mv[2]*x + mv[6]*y + mv[10]*z + mv[14];
  const vw = mv[3]*x + mv[7]*y + mv[11]*z + mv[15];

  const cx = pm[0]*vx + pm[4]*vy + pm[8]*vz  + pm[12]*vw;
  const cy = pm[1]*vx + pm[5]*vy + pm[9]*vz  + pm[13]*vw;
  const cz = pm[2]*vx + pm[6]*vy + pm[10]*vz + pm[14]*vw;
  const cw = pm[3]*vx + pm[7]*vy + pm[11]*vz + pm[15]*vw;

  if (!isFinite(cw) || cw <= 0.0001) return null;

  const ndcX = cx / cw;
  const ndcY = cy / cw;

  return {
    x: (ndcX * 0.5 + 0.5) * width,
    y: (-ndcY * 0.5 + 0.5) * height,
    depth: cw,
  };
}

function placeLabel(el, sp, yOffset = 0, extraOpacity = 1) {
  if (!sp) { el.style.opacity = '0'; return; }
  if (sp.x < -200 || sp.x > width + 200 || sp.y < -200 || sp.y > height + 200) {
    el.style.opacity = '0';
    return;
  }
  el.style.left = sp.x.toFixed(1) + 'px';
  el.style.top  = (sp.y + yOffset).toFixed(1) + 'px';
  const a = Math.max(0.15, Math.min(1, 1 - (sp.depth - 400) / 2200));
  el.style.opacity = (a * extraOpacity).toFixed(3);
}

function updateLabels(stepPos, focusImg, focusStrength) {
  for (const img of images) {
    const sp = worldToScreen(img.pos.x, img.pos.y, img.pos.z);
    const isFocus = img === focusImg;
    const f = isFocus ? focusStrength : 0;

    // 颜色：冷灰暗 → 白亮
    const r = lerp(COLOR_DIM[0], COLOR_LIT[0], f);
    const g = lerp(COLOR_DIM[1], COLOR_LIT[1], f);
    const b = lerp(COLOR_DIM[2], COLOR_LIT[2], f);

    const el = labelEls['img_' + img.name];
    el.style.color = `rgb(${r|0},${g|0},${b|0})`;

    // 聚焦时光晕增强
    const glowOuter = 4 + f * 10;
    const glowMid   = 8 + f * 18;
    el.style.textShadow =
      `0 0 ${glowOuter}px rgba(255,255,255,${0.15 + f * 0.55}),` +
      `0 0 ${glowMid}px rgba(255,255,255,${0.05 + f * 0.45}),` +
      `0 0 3px #000`;

    // 聚焦的标签整体更不透明
    const op = 0.55 + f * 0.45;
    placeLabel(el, sp, -24, op);
  }

  if (showDims) {
    for (const d of dims) {
      if (soloDim && d.id !== soloDim) {
        labelEls['dim_' + d.id].style.opacity = '0';
        continue;
      }
      const tip = d.vec.copy().mult(SCALE * 2.15);
      const sp = worldToScreen(tip.x, tip.y, tip.z);
      placeLabel(labelEls['dim_' + d.id], sp, 0);
    }
  } else {
    for (const d of dims) labelEls['dim_' + d.id].style.opacity = '0';
  }

  const sp = worldToScreen(stepPos.x, stepPos.y, stepPos.z);
  placeLabel(labelEls['step'], sp, -36);
}

function easedOrder(raw) {
  const i = Math.floor(raw);
  const f = raw - i;
  const eased = f * f * (3 - 2 * f);
  return i + eased;
}

function draw() {
  background(5, 5, 16);
  orbitControl();
  ambientLight(255);

  // === 脚步位置 ===
  const raw = t * (images.length - 1);
  const currentOrder = easedOrder(raw);
  const i = Math.min(Math.floor(currentOrder), images.length - 2);
  const frac = currentOrder - i;
  const stepPos = createVector(
    lerp(images[i].pos.x, images[i + 1].pos.x, frac),
    lerp(images[i].pos.y, images[i + 1].pos.y, frac),
    lerp(images[i].pos.z, images[i + 1].pos.z, frac)
  );

  // === 当前聚焦意象 ===
  let focusImg = null;
  let focusDist = Infinity;
  for (const img of images) {
    const d = dist(img.pos.x, img.pos.y, img.pos.z, stepPos.x, stepPos.y, stepPos.z);
    if (d < focusDist) { focusDist = d; focusImg = img; }
  }
  const focusStrength = map(focusDist, 0, 55, 1, 0, true);

  // === 维度轴 + 折线（唯一带颜色的部分） ===
  if (showDims) {
    for (const d of dims) {
      if (soloDim && d.id !== soloDim) continue;

      const [r, g, b] = d.color;
      const focusInDim = focusImg && (focusImg.values[d.id] || 0) > DIM_THRESHOLD;
      const hl = focusInDim ? focusStrength : 0;

      stroke(r, g, b, 18 + hl * 100);
      strokeWeight(1 + hl * 1.5);
      line(0, 0, 0, d.vec.x * SCALE * 2.0, d.vec.y * SCALE * 2.0, d.vec.z * SCALE * 2.0);

      stroke(r, g, b, 22 + hl * 190);
      strokeWeight(1 + hl * 2.2);
      noFill();
      beginShape();
      for (const img of d.points) vertex(img.pos.x, img.pos.y, img.pos.z);
      endShape();
    }
  }

  // === 诗句顺序线（暗） ===
  stroke(255, 255, 255, 18);
  strokeWeight(1);
  noFill();
  beginShape();
  for (const img of images) vertex(img.pos.x, img.pos.y, img.pos.z);
  endShape();

  // 已走过轨迹（暖黄）
  stroke(255, 220, 120, 200);
  strokeWeight(2.5);
  noFill();
  beginShape();
  for (let j = 0; j <= i; j++) vertex(images[j].pos.x, images[j].pos.y, images[j].pos.z);
  vertex(stepPos.x, stepPos.y, stepPos.z);
  endShape();

  // === 意象球体：冷灰暗 → 白亮（仅聚焦时） ===
  for (const img of images) {
    const isFocus = img === focusImg;
    const f = isFocus ? focusStrength : 0;

    // 半径：暗时略小、亮时略大
    const radius = 8 + f * 10;

    // 颜色：从冷灰暗插值到纯白
    const cr = lerp(COLOR_DIM[0], COLOR_LIT[0], f);
    const cg = lerp(COLOR_DIM[1], COLOR_LIT[1], f);
    const cb = lerp(COLOR_DIM[2], COLOR_LIT[2], f);

    push();
    translate(img.pos.x, img.pos.y, img.pos.z);
    noStroke();

    ambientMaterial(cr, cg, cb);
    sphere(radius);

    // 聚焦时加白色光晕
    if (f > 0.02) {
      ambientMaterial(255, 255, 255, 60 * f);
      sphere(radius * 1.6);
    }
    pop();
  }

  // === 脚步光点 ===
  push();
  translate(stepPos.x, stepPos.y, stepPos.z);
  noStroke();
  ambientMaterial(255, 240, 180);
  sphere(13);
  ambientMaterial(255, 220, 120, 70);
  sphere(28);
  pop();

  // === 更新 HTML 标签 ===
  updateLabels(stepPos, focusImg, focusStrength);

  // HUD
  const hud = document.getElementById('hud');
  if (hud) {
    const cur = images[i].name;
    const nxt = i < images.length - 1 ? images[i + 1].name : '—';
    let extra = '';
    if (soloDim) {
      const d = dims.find(dd => dd.id === soloDim);
      extra = `  ·  只看「${d.name}」`;
    }
    hud.innerText = `脚步：${cur} → ${nxt}${extra}`;
  }

  if (playing) {
    t += speed;
    if (t > 1) t = 0;
  }
}

function keyPressed() {
  if (key === ' ') playing = !playing;
  if (key === 'ArrowRight') speed = Math.min(0.006, speed * 1.5);
  if (key === 'ArrowLeft')  speed = Math.max(0.00005, speed / 1.5);
  if (key === 'h' || key === 'H') showDims = !showDims;

  const n = parseInt(key, 10);
  if (n >= 1 && n <= dims.length) {
    const id = dims[n - 1].id;
    soloDim = (soloDim === id) ? null : id;
  }
  if (key === '0') soloDim = null;
}

function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
}
</script>
</body>
</html>
