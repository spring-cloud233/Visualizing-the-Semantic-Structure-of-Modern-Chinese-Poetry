<body>
<div class="app">
  <div class="scene" id="scene">
    <div id="labels"></div>
    <div id="hud">
      <b>1/2/3/4</b> 聚焦某诗 · <b>0</b> 叠加全部<br>
      <b>L</b> 显示/隐藏轨迹线 · <b>空格</b> 暂停 · <b>← →</b> 调速<br>
      <b>拖动/滚轮</b> 旋转缩放 · <b>悬停曲线</b> 联动高亮
    </div>
    <div class="legend" id="legend"></div>
  </div>
  <div class="panel">
    <h2>平行坐标 · 形状对比</h2>
    <canvas id="parallel-canvas" class="chart"></canvas>
    <h2>函数视图 · 走势对比</h2>
    <canvas id="function-canvas" class="chart"></canvas>
    <h2>相关性</h2>
    <div id="correlations"></div>
    <h2>指纹</h2>
    <div id="fingerprints"></div>
  </div>
</div>
<script>
// ============================================================
const DIMS = [
