              text-transform:uppercase; font-weight:500; }
  .panel h2:not(:first-child) { margin-top:22px; }
  canvas.chart { width:100%; display:block;
                 background:rgba(255,255,255,0.015); border-radius:6px; }
  #parallel-canvas { height:210px; }
  #function-canvas { height:250px; cursor:crosshair; }
  #correlations { font-size:12px; }
  .corr-block { margin-bottom:10px; padding:9px 12px; border-radius:6px;
                background:rgba(255,255,255,0.025); }
  .corr-title { font-size:12px; margin-bottom:6px; font-weight:600; }
  .corr-row { display:flex; justify-content:space-between; padding:1px 0;
              font-family:monospace; font-size:11px; color:#999; }
  .corr-row.total { border-top:1px solid rgba(255,255,255,0.08);
                    margin-top:5px; padding-top:5px; color:#fff; font-weight:600; }
  .corr-row .badge { font-size:10px; padding:1px 5px; border-radius:3px;
